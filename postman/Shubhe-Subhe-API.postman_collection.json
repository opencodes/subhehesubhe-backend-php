{
  "info": {
    "_postman_id": "shubhesubhe-api-v1",
    "name": "Shubhe Subhe API (Utsav Connect)",
    "description": "REST API for Utsav Connect — PHP Slim backend at `http://localhost:8080`.\n\n**Setup**\n1. Import this collection and `Local.postman_environment.json`.\n2. Select the **Local** environment.\n3. Run **Auth → Customer Sign In** (saves `token` automatically).\n4. Run secured requests; Bearer auth uses `{{token}}`.\n\n**Seed IDs** (after `composer seed`): `restaurantId=rest-1`, `vendorId=vn-4`, `campaignId=camp-1`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "apiBase", "value": "{{baseUrl}}/api/v1" },
    { "key": "token", "value": "" },
    { "key": "restaurantId", "value": "rest-1" },
    { "key": "vendorId", "value": "vn-4" },
    { "key": "orderId", "value": "" },
    { "key": "campaignId", "value": "camp-1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.collectionVariables.get('token') || pm.environment.get('token');",
          "if (token) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('MongoDB connected', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.success).to.eql(true);",
                  "  pm.expect(j.data.mongodb).to.eql('connected');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Customer Sign In",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\",\n  \"email\": \"customer@example.com\",\n  \"name\": \"Test Customer\",\n  \"customerType\": \"standard\"\n}"
            },
            "url": "{{apiBase}}/auth/sign-in"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Sign in OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.data && j.data.token) {",
                  "  pm.collectionVariables.set('token', j.data.token);",
                  "  pm.environment.set('token', j.data.token);",
                  "  console.log('Saved token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Customer Sign In (Event Planner)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543211\",\n  \"email\": \"planner@example.com\",\n  \"name\": \"Event Planner\",\n  \"customerType\": \"event-planner\"\n}"
            },
            "url": "{{apiBase}}/auth/sign-in"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data && j.data.token) {",
                  "  pm.collectionVariables.set('token', j.data.token);",
                  "  pm.environment.set('token', j.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Vendor Sign In",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543299\",\n  \"email\": \"vendor@example.com\",\n  \"vendorId\": \"{{vendorId}}\",\n  \"businessName\": \"Royal Gardens\",\n  \"contactName\": \"Vendor Contact\"\n}"
            },
            "url": "{{apiBase}}/auth/vendor/sign-in"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data && j.data.token) {",
                  "  pm.collectionVariables.set('token', j.data.token);",
                  "  pm.environment.set('token', j.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register Event Planner",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"New Planner\",\n  \"phone\": \"9123456789\",\n  \"email\": \"new.planner@example.com\",\n  \"companyName\": \"Utsav Events Co\",\n  \"primaryEventType\": \"Wedding\",\n  \"city\": \"Delhi\",\n  \"serviceCities\": [\"Delhi\", \"Noida\"],\n  \"bio\": \"Full-service wedding planner\",\n  \"draftEvent\": {\n    \"name\": \"Sample Wedding\",\n    \"date\": \"2026-12-15\"\n  }\n}"
            },
            "url": "{{apiBase}}/auth/register/planner"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.data && j.data.token) {",
                  "  pm.collectionVariables.set('token', j.data.token);",
                  "  pm.environment.set('token', j.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Auth Me",
          "request": {
            "method": "GET",
            "url": "{{apiBase}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "Categories",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{apiBase}}/catalog/categories"
          }
        },
        {
          "name": "Coupons",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{apiBase}}/catalog/coupons"
          }
        },
        {
          "name": "Vendor Categories",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{apiBase}}/catalog/vendor-categories"
          }
        }
      ]
    },
    {
      "name": "Restaurants",
      "item": [
        {
          "name": "List Restaurants",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{apiBase}}/restaurants?q=&cuisine=&isVeg=",
              "host": ["{{apiBase}}"],
              "path": ["restaurants"],
              "query": [
                { "key": "q", "value": "", "description": "Search name" },
                { "key": "cuisine", "value": "", "description": "Cuisine filter" },
                { "key": "isVeg", "value": "", "description": "true|false" }
              ]
            }
          }
        },
        {
          "name": "Get Restaurant",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{apiBase}}/restaurants/{{restaurantId}}"
          }
        }
      ]
    },
    {
      "name": "Vendors",
      "item": [
        {
          "name": "List Vendors",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{apiBase}}/vendors?category=&city=&q=",
              "host": ["{{apiBase}}"],
              "path": ["vendors"],
              "query": [
                { "key": "category", "value": "", "description": "e.g. venues" },
                { "key": "city", "value": "", "description": "Location search" },
                { "key": "q", "value": "", "description": "Name/location search" }
              ]
            }
          }
        },
        {
          "name": "Get Vendor",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{apiBase}}/vendors/{{vendorId}}"
          }
        },
        {
          "name": "Register Vendor",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"New Venue Listing\",\n  \"location\": \"Jaipur, Rajasthan\",\n  \"city\": \"Jaipur\",\n  \"category\": \"venues\",\n  \"price\": \"₹2L+\",\n  \"email\": \"listing@example.com\",\n  \"phone\": \"9988776655\",\n  \"image\": \"https://images.unsplash.com/photo-1519167758481-83f550bb49b8?w=500\"\n}"
            },
            "url": "{{apiBase}}/vendors/register"
          }
        },
        {
          "name": "Submit Enquiry",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guestName\": \"Test Guest\",\n  \"eventType\": \"Wedding\",\n  \"eventDate\": \"2026-11-20\",\n  \"guests\": \"200-250\",\n  \"message\": \"Interested in full-day venue package.\"\n}"
            },
            "url": "{{apiBase}}/vendors/{{vendorId}}/enquiries"
          }
        },
        {
          "name": "List Vendor Enquiries (auth)",
          "request": {
            "method": "GET",
            "url": "{{apiBase}}/vendors/{{vendorId}}/enquiries",
            "description": "Use **Vendor Sign In** with matching vendorId, or customer token (admin bypass N/A — vendor must match unless role admin)."
          }
        }
      ]
    },
    {
      "name": "Portfolio & Campaigns",
      "item": [
        {
          "name": "Portfolio",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{apiBase}}/portfolio"
          }
        },
        {
          "name": "List Campaigns",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{apiBase}}/campaigns"
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Get Profile",
          "request": { "method": "GET", "url": "{{apiBase}}/users/me" }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Customer\",\n  \"walletBalance\": 500,\n  \"royaltyPoints\": 120\n}"
            },
            "url": "{{apiBase}}/users/me"
          }
        },
        {
          "name": "Add Address",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"Home\",\n  \"addressLine\": \"12 MG Road\",\n  \"landmark\": \"Near Metro\",\n  \"city\": \"Delhi\"\n}"
            },
            "url": "{{apiBase}}/users/me/addresses"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Test Customer\",\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"restaurantName\": \"Kesaria Golden Sweets\",\n  \"restaurantImage\": \"https://images.unsplash.com/photo-1587314168485-3236d6710814?w=500\",\n  \"items\": [\n    {\n      \"name\": \"Kesari Kaju Katli (250g)\",\n      \"price\": 280,\n      \"quantity\": 2\n    }\n  ],\n  \"totalAmount\": 560\n}"
            },
            "url": "{{apiBase}}/orders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "const orderId = j.data?.order?.orderId;",
                  "if (orderId) {",
                  "  pm.collectionVariables.set('orderId', orderId);",
                  "  pm.environment.set('orderId', orderId);",
                  "  console.log('Saved orderId:', orderId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Planner",
      "item": [
        {
          "name": "Get Workspace",
          "request": {
            "method": "GET",
            "url": "{{apiBase}}/planner/workspace",
            "description": "Requires event-planner customer (run **Customer Sign In (Event Planner)** first)."
          }
        },
        {
          "name": "Save Workspace",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"id\": \"evt-1\",\n      \"name\": \"Wedding\",\n      \"date\": \"2026-12-15\",\n      \"venue\": \"Royal Gardens\"\n    }\n  ],\n  \"guests\": [\n    { \"id\": \"g-1\", \"name\": \"Amit Sharma\", \"side\": \"Bride\" }\n  ],\n  \"budgetLimit\": 500000,\n  \"estVillagers\": 50,\n  \"estRelatives\": 200\n}"
            },
            "url": "{{apiBase}}/planner/workspace"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Requires Bearer token (customer role is allowed by API middleware). Run **Customer Sign In** first.",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": { "method": "GET", "url": "{{apiBase}}/admin/stats" }
        },
        {
          "name": "List Customers",
          "request": { "method": "GET", "url": "{{apiBase}}/admin/customers" }
        },
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{apiBase}}/admin/orders?status=",
              "host": ["{{apiBase}}"],
              "path": ["admin", "orders"],
              "query": [
                {
                  "key": "status",
                  "value": "",
                  "description": "Pending | Preparing | Out for Delivery | Delivered | Cancelled"
                }
              ]
            }
          }
        },
        {
          "name": "Get Order",
          "request": { "method": "GET", "url": "{{apiBase}}/admin/orders/{{orderId}}" }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Preparing\"\n}"
            },
            "url": "{{apiBase}}/admin/orders/{{orderId}}/status"
          }
        },
        {
          "name": "Create Restaurant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"rest-test-1\",\n  \"name\": \"Postman Test Kitchen\",\n  \"cuisine\": [\"North Indian\"],\n  \"rating\": 4.2,\n  \"deliveryTime\": 35,\n  \"costForTwo\": 600,\n  \"isVeg\": true,\n  \"menu\": []\n}"
            },
            "url": "{{apiBase}}/admin/restaurants"
          }
        },
        {
          "name": "Update Restaurant",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offerText\": \"20% OFF — Postman test\"\n}"
            },
            "url": "{{apiBase}}/admin/restaurants/{{restaurantId}}"
          }
        },
        {
          "name": "Delete Restaurant",
          "request": {
            "method": "DELETE",
            "url": "{{apiBase}}/admin/restaurants/rest-test-1",
            "description": "Deletes `rest-test-1` created by Create Restaurant — change ID if needed."
          }
        },
        {
          "name": "Create Campaign",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"camp-test-1\",\n  \"title\": \"Postman Festive Offer\",\n  \"description\": \"Test campaign\",\n  \"startDate\": \"2026-05-01\",\n  \"endDate\": \"2026-06-30\",\n  \"status\": \"active\"\n}"
            },
            "url": "{{apiBase}}/admin/campaigns"
          }
        },
        {
          "name": "Update Campaign",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"paused\"\n}"
            },
            "url": "{{apiBase}}/admin/campaigns/{{campaignId}}"
          }
        }
      ]
    }
  ]
}
