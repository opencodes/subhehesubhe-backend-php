APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# Comma-separated origins for CORS (frontend dev server)
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# Use your existing MongoDB instance (no Docker required)
MONGODB_URI=mongodb://127.0.0.1:27017
# With auth: mongodb://USER:PASS@127.0.0.1:27017/?authSource=admin
MONGODB_DATABASE=shubhesubhe

JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_TTL_SECONDS=604800

# Root platform account (auto-created in MongoDB on first API start if missing)
ROOT_USERNAME=root
ROOT_PASSWORD=change-me-root-password
